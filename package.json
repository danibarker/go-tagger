  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "install-server": "cd go-tagger-server && go mod tidy",
    "install-client": "cd go-tagger-client && npm install --no-bin-links",
    "build-client": "cd go-tagger-client && npm run build",
    "restart": "sudo systemctl restart photos.service",
    "start": "sudo systemctl start photos.service",
    "stop": "sudo systemctl stop photos.service",
    "status": "sudo systemctl status photos.service",
    "install": "npm run install-client && npm run install-server",
    "build-server": "cd go-tagger-server && go build .",
    "build": "npm run install && npm run build-client && npm run build-server"
  },
